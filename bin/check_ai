#!/usr/bin/env python3
"""check_ai — AI API 端点连通性检测（fire 重构）"""
from __future__ import annotations

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
from lib.check_ai import check, default_proxy
from lib.fire_base import BaseCli, run_cli, timed_cli


class CheckAiCli(BaseCli):
    """AI API 端点连通性检测（空 POST，无任何密钥；HTTP 状态码 / TTFB / 断流）"""

    def __call__(
        self,
        *args: str,
        count: int = 5,
        infinite: bool = False,
        timeout: float = 15.0,
        interval: float = 5.0,
        proxy: str | None = None,
    ):
        """裸调用 `check_ai <端点名|URL>` 等同 `check_ai probe <端点名|URL>`"""
        if not args:
            self._r.err("check_ai: 缺少端点名或 URL")
            return 1
        target = args[0]
        return self.probe(
            target,
            count=count, infinite=infinite, timeout=timeout,
            interval=interval, proxy=proxy,
        )

    @timed_cli
    def probe(
        self,
        target: str,
        *,
        count: int = 5,
        infinite: bool = False,
        timeout: float = 15.0,
        interval: float = 5.0,
        proxy: str | None = None,
    ):
        """探测 AI 端点连通性

        用法: check_ai probe <端点名|URL> [--count N] [--infinite] [--timeout S] [--interval S] [--proxy URL]

        端点名: claude/codex/openai/glm/kimi/minimax（不读环境密钥）
        """
        return check(
            target,
            count=count,
            infinite=infinite,
            timeout=timeout,
            interval=interval,
            proxy=proxy if proxy is not None else default_proxy(),
        )


if __name__ == "__main__":
    run_cli(CheckAiCli())
