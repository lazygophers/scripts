        return 0

    @cmd
    def delete(self, pk: int, host: str = ""):
        """删除资源组

        用法: archery user resourcegroup delete 2
        """
        self._client(host).delete(f"v1/user/resourcegroup/{int(pk)}/")
        self._r.ok(f"已删除资源组 {pk}")
        return 0


class UserCli(_Group):
    """用户管理"""

    def __init__(self, reporter_obj: Reporter | None = None) -> None:
        super().__init__(reporter_obj)
        self.group = UserGroupCli(self._r)
        self.resourcegroup = ResourceGroupCli(self._r)
        self.twofa = TwoFACli(self._r)

    @cmd
    def list(self, host: str = "", **params):
        """列出用户。过滤参数直接透传（--username / --id / --page / --size）

        用法:
          archery user list --size 50
          archery user list --username nico
        """
        emit(self._client(host).get("v1/user/", **params))
        return 0

    @cmd
    def create(self, data, host: str = ""):
        """新建用户。字段同 Archery 的 Users 模型，display 必填

        用法: archery user create --data '{"username":"nico","display":"Nico","password":"..."}'
        """
        emit(self._client(host).post("v1/user/", parse_data(data)))
        return 0

    @cmd
    def update(self, pk: int, data, host: str = ""):
        """更新用户（PUT，只传要改的字段即可，username/password 可选）

        用法: archery user update 7 --data '{"display":"Nico L"}'
        """
        emit(self._client(host).put(f"v1/user/{int(pk)}/", parse_data(data)))
        return 0

    @cmd
    def delete(self, pk: int, host: str = ""):
        """删除用户

        用法: archery user delete 7
        """
        self._client(host).delete(f"v1/user/{int(pk)}/")
        self._r.ok(f"已删除用户 {pk}")
        return 0

    @cmd
    def auth(self, engineer: str, password: str, host: str = ""):
        """校验某个用户的账号密码（不改变本地登录状态）

        用法: archery user auth nico 'secret'
        """
        emit(self._client(host).post("v1/user/auth/", {"engineer": engineer, "password": password}))
        return 0


