#!/usr/bin/env python3
"""archery — Archery(hhyo/archery) 的命令行客户端，按域名分别保存登录

顶层命令:
  login       录入一个站点的地址 / 用户名 / 密码（可选 2FA 密钥），登录并保存
  hosts       列出已配置的站点，标出当前默认那个
  use         切换默认站点
  show        查看某个站点的配置，含明文密码 / 密钥 / token —— 需要 root
  logout      清掉 token（加 --forget 连账号密码一起删）
  code        打印当前 TOTP 验证码（不请求服务端）—— 需要 root
  info        站点版本信息（GET /api/info）
  schema      列出这个站点支持的全部 API 端点（读 /api/schema/）
  api         直接发任意请求，覆盖 schema 里所有端点

子命令组:
  user        用户 / 用户组 / 资源组 / 2FA
  instance    实例、隧道、阿里云 RDS、实例资源
  query       SQLQuery：查实例、查资源、看表结构、执行查询、历史记录、收藏
  workflow    工单：清单、提交、SQL 检查、审核、待审清单、执行、日志

配置文件: ~/.config/lazygophers/scripts/archery.yaml（权限 0600）
所有命令都支持 --host <域名> 临时指向另一个站点。

会把密钥 / 验证码打到屏幕上的只有 `show` 和 `code` 两条，它们要 root：不是 root
时自动 `sudo` 重跑同一条命令（终端向你要密码）。其余命令，包括所有取数据的查询，
普通用户直接跑。
"""
from __future__ import annotations

import json
import pathlib
import sys
from functools import wraps

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
from lib.archery import (
    CONFIG_PATH,
    ArcheryClient,
    ArcheryError,
    client_for,
    default_config_path,
    flatten_schema,
    host_key,
    load_config,
    normalize_url,
    parse_data,
    profiles,
    put_profile,
    require_root,
    resolve_profile,
    save_config,
)
from lib.fire_base import BaseCli, run_cli, timed_cli
from lib.ovpn import normalize_secret, totp
from lib.ui import Reporter, ask_confirm, ask_text, reporter


SCRIPT_PATH = pathlib.Path(__file__).resolve()
# run_cli 会从 sys.argv 里剥掉 --debug / --no-say，提权重跑要的是没被动过的原始 argv
ORIG_ARGV = list(sys.argv)


def _config_path(config: str = "") -> pathlib.Path:
    """--config 指定的路径优先，否则按当前身份推断（sudo 下回落到原用户家目录）。"""
    return pathlib.Path(config).expanduser() if config else default_config_path()


def emit(data) -> None:
    """API 返回值统一打到 stdout（JSON），报错和进度走 stderr，方便 `| jq`。"""
    if data is None:
        return
    if isinstance(data, str):
        print(data)
    else:
        print(json.dumps(data, ensure_ascii=False, indent=2))


def cmd(method):
    """子命令装饰器：计时 + 把 ArcheryError 变成一行人话（不甩 traceback）。"""

    @timed_cli
    @wraps(method)
    def wrapper(self, *args, **kwargs):
        try:
            return method(self, *args, **kwargs)
        except ArcheryError as e:
            self._r.err(str(e))
            return 2

    return wrapper


class _Group:
    """子命令组基类。属性一律带下划线，否则 fire 会把它们当成子命令列出来。"""

    def __init__(self, reporter_obj: Reporter | None = None) -> None:
        self._r = reporter_obj or reporter(stderr=True)

    def _client(self, host: str = ""):
        return client_for(host, reporter=self._r)


# ---------------------------------------------------------------- user

class TwoFACli(_Group):
    """两步验证（TOTP / 短信）配置"""

    @cmd
    def state(self, engineer: str, host: str = ""):
        """查某个用户的 2FA 开启情况

        用法: archery user twofa state nico
        """
        emit(self._client(host).post("v1/user/2fa/state/", {"engineer": engineer}))
        return 0

    @cmd
    def enable(self, engineer: str, auth_type: str = "totp", phone: str = "", host: str = ""):
        """开启 2FA。totp 返回密钥（拿去 save 保存），sms 会给手机发验证码

        用法:
          archery user twofa enable nico
          archery user twofa enable nico --auth-type sms --phone 13800000000
        """
        body = {"engineer": engineer, "enable": "true", "auth_type": auth_type}
        if phone:
            body["phone"] = phone
        emit(self._client(host).post("v1/user/2fa/", body))
        return 0

    @cmd
    def disable(self, engineer: str, auth_type: str = "totp", host: str = ""):
        """关闭 2FA

        用法: archery user twofa disable nico
        """
        emit(self._client(host).post(
            "v1/user/2fa/", {"engineer": engineer, "enable": "false", "auth_type": auth_type}))
        return 0

    @cmd
    def save(self, engineer: str, auth_type: str = "totp", key: str = "", phone: str = "",
             host: str = ""):
        """保存 2FA 配置（totp 传 --key，sms 传 --phone，关闭传 --auth-type disabled）

        用法: archery user twofa save nico --key JBSWY3DPEHPK3PXP
        """
        body = {"engineer": engineer, "auth_type": auth_type}
        if key:
            body["key"] = key
        if phone:
            body["phone"] = phone
        emit(self._client(host).post("v1/user/2fa/save/", body))
        return 0

    @cmd
    def verify(self, engineer: str, otp: int, auth_type: str = "totp", key: str = "",
               phone: str = "", host: str = ""):
        """校验一次性验证码

        用法: archery user twofa verify nico 123456
        """
        body = {"engineer": engineer, "otp": int(otp), "auth_type": auth_type}
        if key:
            body["key"] = key
        if phone:
            body["phone"] = phone
        emit(self._client(host).post("v1/user/2fa/verify/", body))
        return 0


class UserGroupCli(_Group):
    """Django 用户组（权限组）"""

    @cmd
    def list(self, host: str = "", **params):
        """列出用户组（支持 --page / --size）

        用法: archery user group list --size 50
        """
        emit(self._client(host).get("v1/user/group/", **params))
        return 0

    @cmd
    def create(self, data, host: str = ""):
        """新建用户组。--data 传 JSON 或 @file.json

        用法: archery user group create --data '{"name":"dba"}'
        """
        emit(self._client(host).post("v1/user/group/", parse_data(data)))
        return 0

    @cmd
    def update(self, pk: int, data, host: str = ""):
        """更新用户组（整体覆盖，PUT）

        用法: archery user group update 3 --data '{"name":"dba"}'
        """
        emit(self._client(host).put(f"v1/user/group/{int(pk)}/", parse_data(data)))
        return 0

    @cmd
    def delete(self, pk: int, host: str = ""):
        """删除用户组

        用法: archery user group delete 3
        """
        self._client(host).delete(f"v1/user/group/{int(pk)}/")
        self._r.ok(f"已删除用户组 {pk}")
        return 0


