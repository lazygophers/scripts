class InstanceCli(_Group):
    """数据库实例管理"""

    def __init__(self, reporter_obj: Reporter | None = None) -> None:
        super().__init__(reporter_obj)
        self.tunnel = TunnelCli(self._r)
        self.rds = RdsCli(self._r)

    @cmd
    def list(self, host: str = "", **params):
        """列出实例。过滤：--id / --instance_name__icontains / --db_type / --host_ip / --page / --size

        实例的 host 字段过滤参数写 `--host_ip` 会被原样透传成 `host`；因为 `--host`
        已经被本工具用来选站点了，需要按实例 IP 过滤时改用 `archery api` 直接发。

        用法:
          archery instance list --size 50
          archery instance list --db_type mysql
        """
        params = dict(params)
        if "host_ip" in params:
            params["host"] = params.pop("host_ip")
        emit(self._client(host).get("v1/instance/", **params))
        return 0

    @cmd
    def create(self, data, host: str = ""):
        """新建实例

        用法: archery instance create --data @instance.json
        """
        emit(self._client(host).post("v1/instance/", parse_data(data)))
        return 0

    @cmd
    def update(self, pk: int, data, host: str = ""):
        """更新实例（PUT）

        用法: archery instance update 5 --data '{"host":"10.0.0.9"}'
        """
        emit(self._client(host).put(f"v1/instance/{int(pk)}/", parse_data(data)))
        return 0

    @cmd
    def delete(self, pk: int, host: str = ""):
        """删除实例

        用法: archery instance delete 5
        """
        self._client(host).delete(f"v1/instance/{int(pk)}/")
        self._r.ok(f"已删除实例 {pk}")
        return 0

    @cmd
    def resource(self, instance_id: int, resource_type: str, db_name: str = "",
                 schema_name: str = "", tb_name: str = "", host: str = ""):
        """列实例内的资源：database / schema / table / column / server_info

        用法:
          archery instance resource 5 database
          archery instance resource 5 table --db-name orders
          archery instance resource 5 column --db-name orders --tb-name t_order
        """
        body = {"instance_id": int(instance_id), "resource_type": resource_type}
        for key, value in (("db_name", db_name), ("schema_name", schema_name), ("tb_name", tb_name)):
            if value:
                body[key] = value
        emit(self._client(host).post("v1/instance/resource/", body))
        return 0

    @cmd
    def locate(self, table_name: str, host: str = ""):
        """按表名反查这张表在哪些实例上

        用法: archery instance locate t_order
        """
        emit(self._client(host).post("v1/instance/table-instances/", {"table_name": table_name}))
        return 0


# ---------------------------------------------------------------- sqlquery

def _api_or_web(api, web):
    """先走 REST API；老版本 Archery（1.9.x）没有 sqlquery 那组端点，404 时回落到网页端。"""
    try:
        return api()
    except ArcheryError as e:
        if "HTTP 404" not in str(e):
            raise
        return web()


class QueryCli(_Group):
    """SQLQuery：在线查询与历史记录"""

    @cmd
    def instances(self, host: str = "", **params):
        """列出当前用户能查询的实例（--db_type / --tag_codes / --type）

        用法: archery query instances --db_type mysql
        """
        client = self._client(host)
        emit(_api_or_web(
            lambda: client.get("v1/sqlquery/instances/", **params),
            lambda: client.web("POST", "/group/user_all_instances/", form=params),
        ))
        return 0

    @cmd
    def resources(self, resource_type: str, instance_name: str = "", instance_id: int = 0,
                  db_name: str = "", schema_name: str = "", tb_name: str = "", host: str = ""):
        """列查询视角下的库 / 表 / 列（resource_type: database|schema|table|column|server_info）

        用法: archery query resources table --instance-name prod-mysql --db-name orders
        """
        params = {"resource_type": resource_type, "instance_name": instance_name,
                  "db_name": db_name, "schema_name": schema_name, "tb_name": tb_name}
        if instance_id:
            params["instance_id"] = int(instance_id)
        client = self._client(host)
        emit(_api_or_web(
            lambda: client.get("v1/sqlquery/resources/", **params),
            lambda: client.web("GET", "/instance/instance_resource/", params=params),
        ))
        return 0

    @cmd
    def describe(self, instance_name: str, db_name: str, tb_name: str,
                 schema_name: str = "", host: str = ""):
        """看表结构

        用法: archery query describe prod-mysql orders t_order
        """
        body = {"instance_name": instance_name, "db_name": db_name,
                "tb_name": tb_name, "schema_name": schema_name}
        client = self._client(host)
        emit(_api_or_web(
            lambda: client.post("v1/sqlquery/describetable/", body),
            lambda: client.web("POST", "/instance/describetable/", form=body),
        ))
        return 0

    @cmd
    def execute(self, sql: str, instance_name: str, db_name: str, schema_name: str = "",
                tb_name: str = "", limit_num: int = 0, host: str = "",
                json_out: bool = False, table: bool = False):
        """执行一条查询。sql 可以写 `@file.sql` 从文件读

        默认输出 TSV（首行列名，制表符分隔，方便 `| cut` / 贴表格）；
        --table 渲染成框线表格，--json-out 输出原始 JSON（方便 `| jq`）。

        用法:
          archery query execute 'select 1' --instance-name prod-mysql --db-name orders
          archery query execute @big.sql --instance-name prod-mysql --db-name orders --limit-num 100
        """
        sql_text = str(sql)
        if sql_text.startswith("@"):
            path = pathlib.Path(sql_text[1:]).expanduser()
            if not path.is_file():
                raise ArcheryError(f"读不到 SQL 文件: {path}")
            sql_text = path.read_text(encoding="utf-8")

        body = {"instance_name": instance_name, "db_name": db_name, "schema_name": schema_name,
                "tb_name": tb_name, "sql_content": sql_text, "limit_num": int(limit_num)}
        client = self._client(host)
        data = _api_or_web(
            lambda: client.post("v1/sqlquery/execute/", body),
            lambda: client.web("POST", "/query/", form=body),
        )
        render = _render_table if table else _render_tsv
        if json_out or not render(data):
            emit(data)
        return 0

    @cmd
    def logs(self, host: str = "", **params):
        """历史查询记录（--limit / --offset / --search / --star / --start_date / --end_date）

        用法: archery query logs --limit 20 --search t_order
        """
        client = self._client(host)
        emit(_api_or_web(
            lambda: client.get("v1/sqlquery/logs/", **params),
            lambda: client.web("GET", "/query/querylog/", params=params),
        ))
        return 0

    @cmd
    def favorite(self, query_log_id: int, star: bool = True, alias: str = "", host: str = ""):
        """收藏 / 取消收藏一条查询记录

        用法:
          archery query favorite 123 --alias '订单表全量'
          archery query favorite 123 --no-star
        """
        body = {"query_log_id": int(query_log_id),
                "star": "true" if star else "false",
                "alias": alias}
        client = self._client(host)
        emit(_api_or_web(
            lambda: client.post("v1/sqlquery/favorites/", body),
            lambda: client.web("POST", "/query/favorite/", form=body),
        ))
        return 0


def _result_rows(data):
    """从查询响应里取出 (columns, rows)，形状不对时返回 None。"""
    payload = data.get("data") if isinstance(data, dict) else None
    if not isinstance(payload, dict):
        payload = data if isinstance(data, dict) else None
    if not isinstance(payload, dict):
        return None
    columns = payload.get("column_list")
    rows = payload.get("rows")
    if not isinstance(columns, list) or not isinstance(rows, list):
        return None
    values = [row if isinstance(row, (list, tuple)) else [row.get(c) for c in columns]
              for row in rows]
    return columns, values


def _tsv_cell(value) -> str:
    """一个单元格转成一行 TSV 里的一段：制表符和换行转义掉，免得撑破行列。"""
    if value is None:
        return ""
    return str(value).replace("\\", "\\\\").replace("\t", "\\t").replace("\r", "\\r").replace("\n", "\\n")


def _render_tsv(data) -> bool:
    """把查询结果按 TSV 打到 stdout（首行列名），返回是否渲染成功。"""
    got = _result_rows(data)
    if got is None:
        return False
    columns, rows = got
    lines = ["\t".join(_tsv_cell(c) for c in columns)]
    lines += ["\t".join(_tsv_cell(v) for v in row) for row in rows]
    print("\n".join(lines))
    return True


def _render_table(data) -> bool:
    """把查询结果渲染成框线表格，返回是否渲染成功。"""
    got = _result_rows(data)
    if got is None:
        return False
    columns, rows = got

    from rich.console import Console
    from rich.table import Table

    table = Table(show_lines=False)
    for col in columns:
        table.add_column(str(col), overflow="fold")
    for row in rows:
        table.add_row(*["" if v is None else str(v) for v in row])
    Console().print(table)
    return True


# ---------------------------------------------------------------- workflow

class WorkflowCli(_Group):
    """SQL 上线工单"""

    @cmd
    def list(self, host: str = "", **params):
        """工单清单。过滤透传，如 --workflow__status / --workflow__engineer / --page / --size

        用法: archery workflow list --size 20
        """
        emit(self._client(host).get("v1/workflow/", **params))
        return 0

    @cmd
    def check(self, instance_id: int, db_name: str, full_sql: str, host: str = ""):
        """提交前的 SQL 语法 / 规则检查。full_sql 可写 `@file.sql`

        用法: archery workflow check 5 orders @change.sql
        """
        sql_text = str(full_sql)
        if sql_text.startswith("@"):
            path = pathlib.Path(sql_text[1:]).expanduser()
            if not path.is_file():
                raise ArcheryError(f"读不到 SQL 文件: {path}")
            sql_text = path.read_text(encoding="utf-8")
        emit(self._client(host).post("v1/workflow/sqlcheck/", {
            "instance_id": int(instance_id), "db_name": db_name, "full_sql": sql_text,
        }))
        return 0

    @cmd
    def submit(self, data, host: str = ""):
        """提交一条 SQL 上线工单。--data 是 WorkflowContent 的 JSON（含嵌套 workflow 对象）

        用法: archery workflow submit --data @workflow.json
        """
        emit(self._client(host).post("v1/workflow/", parse_data(data)))
        return 0

    @cmd
    def audit(self, engineer: str, workflow_id: int, audit_remark: str,
              workflow_type: int = 2, audit_type: str = "pass", host: str = ""):
        """审核工单。workflow_type: 1-查询权限 2-SQL 上线 3-数据归档；audit_type: pass / cancel

        用法: archery workflow audit nico 42 '看过了' --audit-type pass
        """
        emit(self._client(host).post("v1/workflow/audit/", {
            "engineer": engineer, "workflow_id": int(workflow_id),
            "audit_remark": audit_remark, "workflow_type": int(workflow_type),
            "audit_type": audit_type,
        }))
        return 0

    @cmd
    def auditlist(self, engineer: str, host: str = "", **params):
        """某个用户的待审核清单（--workflow_type / --page / --size）

        用法: archery workflow auditlist nico
        """
        emit(self._client(host).post("v1/workflow/auditlist/", {"engineer": engineer}, **params))
        return 0

    @cmd
    def execute(self, workflow_id: int, engineer: str = "", workflow_type: int = 2,
                mode: str = "auto", host: str = ""):
        """执行工单。workflow_type 2 = SQL 上线（需 engineer），3 = 数据归档；mode: auto / manual

        用法: archery workflow execute 42 --engineer nico
        """
        body = {"workflow_id": int(workflow_id), "workflow_type": int(workflow_type)}
        if int(workflow_type) == 2:
            if not engineer:
                raise ArcheryError("SQL 上线工单必须带 --engineer（执行人用户名）")
            body["engineer"] = engineer
            body["mode"] = mode
        emit(self._client(host).post("v1/workflow/execute/", body))
        return 0

    @cmd
    def log(self, workflow_id: int, workflow_type: int = 2, host: str = "", **params):
        """工单流转日志

        用法: archery workflow log 42
        """
        emit(self._client(host).post(
            "v1/workflow/log/",
            {"workflow_id": int(workflow_id), "workflow_type": int(workflow_type)},
            **params))
        return 0


# ---------------------------------------------------------------- 顶层

class ArcheryCli(BaseCli):
    """archery — Archery 的命令行客户端，按域名分别保存登录"""

    def __init__(self) -> None:
        super().__init__()
        self.user = UserCli(self._r)
        self.instance = InstanceCli(self._r)
        self.query = QueryCli(self._r)
        self.workflow = WorkflowCli(self._r)

    @cmd
    def login(self, url: str = "", username: str = "", password: str = "",
              totp_secret: str = "", insecure: bool = False, current: bool = True):
        """录入一个站点的凭据，登录一次验证通过后写进配置文件

        没给参数就逐项交互询问（已有值直接回车沿用）。同一域名重复 login 覆盖旧值。
        每个域名一份独立的用户名 / 密码 / token，互不影响。

        参数:
          --url         站点地址，写 archery.example.com 或完整 URL 都行
          --username    用户名
          --password    密码
          --totp-secret 可选，2FA 密钥（base32 或 otpauth:// 整串），只给 `archery code` 用
          --insecure    跳过 TLS 证书校验（自签证书的内网站点）
          --no-current  不把这个站点设成默认

        用法:
          archery login
          archery login --url archery.example.com --username nico --password 'secret'
        """
        cfg = load_config()
        known = profiles(cfg)

        if not url:
            url = ask_text("Archery 站点地址", default=str(cfg.get("current") or "")) or ""
            if not url.strip():
                self._r.err("已取消")
                return 1
        site = normalize_url(url)
        key = host_key(site)
        old = dict(known.get(key) or {})

        if not username:
            username = ask_text("用户名", default=str(old.get("username") or "")) or ""
            if not username.strip():
                self._r.err("已取消")
                return 1
        if not password:
            password = ask_text("密码", default=str(old.get("password") or "")) or ""
            if not password:
                self._r.err("已取消")
                return 1
        if not totp_secret and not old.get("totp_secret"):
            has_totp = ask_confirm("这个站点开了两步验证吗？", default=False)
            if has_totp:
                totp_secret = ask_text("2FA 密钥 (base32 或 otpauth:// 整串)") or ""

        secret = normalize_secret(totp_secret) if totp_secret else str(old.get("totp_secret") or "")
        if secret:
            try:
                totp(secret)  # 只验格式，验证码不打出来（要看得 `sudo archery code`）
                self._r.ok("2FA 密钥格式可用")
            except ValueError as e:
                self._r.err(str(e))
                return 2

        profile = {
            "url": site,
            "username": username.strip(),
            "password": password,
            "totp_secret": secret,
            "insecure": bool(insecure or old.get("insecure")),
            "token": {},
        }
        put_profile(cfg, key, profile)
        if current:
            cfg["current"] = key

        client = ArcheryClient(key, profile, cfg, reporter=self._r)
        client.login()  # 失败会抛 ArcheryError，配置不落盘
        self._r.ok(f"{key} 登录成功，已写入 {CONFIG_PATH}（权限 0600）")
        if not current:
            self._r.info(f"当前默认站点仍是 {cfg.get('current')}；切换用 `archery use {key}`")
        return 0

    @cmd
    def hosts(self):
        """列出已配置的站点，★ 是当前默认那个

        用法: archery hosts
        """
        cfg = load_config()
        known = profiles(cfg)
        if not known:
            self._r.warn(f"还没有配置任何站点（{CONFIG_PATH}）。跑 `archery login`")
            return 1
        current = str(cfg.get("current") or "")
        self._r.kv("已配置站点", {
            ("★ " + key if key == current else "  " + key):
                f"{profile.get('url')}  用户 {profile.get('username') or '(未设置)'}"
            for key, profile in sorted(known.items())
        })
        return 0

    @cmd
    def use(self, host: str):
        """切换默认站点

        用法: archery use archery.example.com
        """
        cfg = load_config()
        key, _ = resolve_profile(cfg, host)
        cfg["current"] = key
        save_config(cfg)
        self._r.ok(f"默认站点已切到 {key}")
        return 0

    @cmd
    def show(self, host: str = "", config: str = ""):
        """查看某个站点的配置，含明文密码 / 2FA 密钥 / token —— 需要 root

        不是 root 时会自动用 sudo 重跑这条命令（终端会向你要密码）。密钥只在
        拿到 root 之后才明文打出来，所以别在别人能看到的屏幕上跑。

        参数:
          --config <路径>  指定配置文件（sudo 重跑时自动带上，一般不用手写）

        用法: archery show --host archery.example.com
        """
        path = _config_path(config)
        require_root(SCRIPT_PATH, ORIG_ARGV[1:], path)
        cfg = load_config(path)
        key, profile = resolve_profile(cfg, host)
        token = profile.get("token") or {}
        self._r.kv(f"{key}（{path}）", {
            "站点地址": str(profile.get("url") or "(未设置)"),
            "用户名": str(profile.get("username") or "(未设置)"),
            "密码": str(profile.get("password") or "(未设置)"),
            "2FA 密钥": str(profile.get("totp_secret") or "(未设置)"),
            "TLS 校验": "关（--insecure）" if profile.get("insecure") else "开",
            "access token": str(token.get("access") or "(未设置)"),
            "refresh token": str(token.get("refresh") or "(未设置)"),
            "是否默认站点": "是" if key == str(cfg.get("current") or "") else "否",
        })
        return 0

    @cmd
    def logout(self, host: str = "", forget: bool = False):
        """清掉 token（下次请求会用保存的密码自动重登）；--forget 连账号密码一起删

        用法:
          archery logout
          archery logout --host archery.example.com --forget
        """
        cfg = load_config()
        key, profile = resolve_profile(cfg, host)
        known = profiles(cfg)
        if forget:
            known.pop(key, None)
            cfg["profiles"] = known
            if cfg.get("current") == key:
                cfg["current"] = next(iter(sorted(known)), "")
            save_config(cfg)
            self._r.ok(f"已删除 {key} 的全部配置")
            return 0
        profile["token"] = {}
        put_profile(cfg, key, profile)
        save_config(cfg)
        self._r.ok(f"已清掉 {key} 的 token（账号密码保留）")
        return 0

    @cmd
    def code(self, host: str = "", config: str = ""):
        """打印当前 TOTP 验证码（本地算，不请求服务端）—— 需要 root

        验证码是密钥直接算出来的，等于间接暴露密钥，所以和 `show` 同一个门槛：
        不是 root 时自动用 sudo 重跑。

        用法: archery code
        """
        path = _config_path(config)
        require_root(SCRIPT_PATH, ORIG_ARGV[1:], path)
        cfg = load_config(path)
        key, profile = resolve_profile(cfg, host)
        secret = str(profile.get("totp_secret") or "")
        if not secret:
            self._r.err(f"{key} 没配 2FA 密钥。跑 `archery login --url {key}`")
            return 1
        try:
            print(totp(secret))
        except ValueError as e:
            self._r.err(str(e))
            return 2
        return 0

    @cmd
    def info(self, host: str = ""):
        """站点信息（版本等），顺带验证 token 还有效

        用法: archery info
        """
        emit(self._client(host).get("/api/info"))
        return 0

    @cmd
    def schema(self, host: str = "", grep: str = "", raw: bool = False):
        """列出这个站点支持的全部 API 端点（读 /api/schema/）

        拿到 path 后用 `archery api <method> <path>` 就能调任意一个。

        参数:
          --grep 只显示 path 或摘要里含这个词的端点
          --raw  直接吐原始 OpenAPI JSON

        用法:
          archery schema
          archery schema --grep workflow
        """
        client = self._client(host)
        data = client.request("GET", "/api/schema/", params={"format": "json"})
        if isinstance(data, str):
            import yaml

            data = yaml.safe_load(data)
        if raw:
            emit(data)
            return 0
        rows = flatten_schema(data if isinstance(data, dict) else {})
        needle = grep.lower()
        if needle:
            rows = [r for r in rows if needle in r[1].lower() or needle in r[2].lower()]
        if not rows:
            self._r.warn("没有匹配的端点")
            return 1
        for method, path, summary in rows:
            print(f"{method:<6} {path}" + (f"   # {summary}" if summary else ""))
        self._r.info(f"共 {len(rows)} 个端点；调用: archery api <method> <path>")
        return 0

    @cmd
    def api(self, method: str, path: str, data=None, host: str = "", **params):
        """直接发任意请求，schema 里的端点都能调

        path 三种写法都行：`v1/user/`（自动补 /api/）、`/api/v1/user/`、完整 URL。
        剩下的 `--key value` 全部当查询参数透传。

        用法:
          archery api get v1/user/ --size 50
          archery api post v1/workflow/sqlcheck/ --data '{"instance_id":5,"db_name":"orders","full_sql":"select 1"}'
          archery api delete v1/user/7/
        """
        body = parse_data(data) if data is not None else None
        emit(self._client(host).request(
            method, path,
            params={k: v for k, v in params.items() if v is not None} or None,
            json_body=body,
        ))
        return 0

    def _client(self, host: str = ""):
        return client_for(host, reporter=self._r)


if __name__ == "__main__":
    run_cli(ArcheryCli())
