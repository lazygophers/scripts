#!/usr/bin/env python3
"""cpd 薄壳入口 — 深度覆盖复制。"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
from lib.cpd import copy
from lib.notify import consume_debug, consume_help, consume_no_say
from lib.ui import timed

sys.argv = consume_help(
    consume_debug(consume_no_say(sys.argv)),
    __doc__,
    usage="cpd [选项] <源...> <目标>",
)
raise SystemExit(timed(copy, label="cpd")(sys.argv))
