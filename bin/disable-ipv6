#!/usr/bin/env bash
# disable-ipv6.sh — 关闭本机所有网络服务的 IPv6
set -euo pipefail

case " ${*:1} " in
  *" --skills "*)
    cat <<'EOF'
# disable-ipv6 skills

受众：使用本命令的 AI agent。
概述：关闭本机所有网络服务的 IPv6。

何时用：
- 用 networksetup 关闭本机所有 macOS 网络服务的 IPv6。
- 需要 sudo/root；改主机网络配置。

通用约定：
- 组参前先跑 `--help` 看人类可读用法。
- 改主机网络配置前先和用户确认。
EOF
    exit 0
    ;;
  *" --help "*|*" -h "*)
    cat <<'EOF'
disable-ipv6 — 关闭本机所有网络服务的 IPv6

用法: disable-ipv6

选项:
  -h, --help    显示帮助并退出
  --skills      显示给 AI 看的命令能力说明并退出
EOF
    exit 0
    ;;
esac

[[ $EUID -eq 0 ]] || { echo "需 sudo 运行"; exit 1; }

networksetup -listallnetworkservices | tail -n +2 | sed 's/^\*//' | while IFS= read -r svc; do
  [[ -z "$svc" ]] && continue
  if networksetup -setv6off "$svc" 2>/dev/null; then
    echo "off: $svc"
  else
    echo "skip: $svc"
  fi
done
