#!/usr/bin/env python3
"""push_branch — 批量推送当前分支到远端同名分支（fire 重构）"""
from __future__ import annotations

import os
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
from lib.batch_git import push_branch_all
from lib.fire_base import BaseCli, run_cli, timed_cli


class PushBranchCli(BaseCli):
    """批量推送当前分支到远端同名分支"""

    def __call__(self, force: bool = False):
        """裸调用 `push_branch` 等同 `push_branch current`（推送当前分支）"""
        return self.current(force=force)

    @timed_cli
    def current(self, force: bool = False):
        """推送各仓库当前分支（先 pull --ff-only 再 push）

        用法: push_branch current [--force]
        """
        return push_branch_all(branch=None, force=force)

    @timed_cli
    def to(self, branch: str, force: bool = False):
        """推送指定分支

        用法: push_branch to <branch> [--force]
        """
        return push_branch_all(branch=branch, force=force)


if __name__ == "__main__":
    run_cli(PushBranchCli())
