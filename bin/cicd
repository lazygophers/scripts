#!/usr/bin/env python3
"""cicd — 查看、监听、启用 GitHub/GitLab CI/CD

常用：
  cicd                  # 等 CI/CD 跑完（流水线由 push 自动创建，不手动触发）
  cicd now              # 看当前状态
  cicd play 90947       # 启用 GitLab manual job
  cicd id 123           # 等某个 run/pipeline
  cicd fail 123         # 看失败日志
"""
from __future__ import annotations

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
from lib.cicd import PollConfig, logs_cicd, play_cicd, status_cicd, watch_cicd
from lib.fire_base import BaseCli, run_cli, timed_cli


class CicdCli(BaseCli):
    """查看、监听、启用 GitHub/GitLab CI/CD

    常用：
      cicd                  # 等当前分支 CI/CD 跑完（流水线由 push 自动创建）
      cicd now              # 看当前分支最新状态
      cicd play 90947       # 启用 GitLab manual job
      cicd id 123           # 等某个 run/pipeline 跑完
      cicd fail 123         # 看失败日志
    """

    def __call__(
        self,
        ref: str | None = None,
        *,
        project: str = "",
        min_interval: float = 5.0,
        max_interval: float = 30.0,
        timeout: float | None = None,
        verbose: bool = False,
    ):
        """裸调用 `cicd [ref]` 等同 `cicd watch [ref]`"""
        return self.watch(
            ref,
            project=project,
            min_interval=min_interval,
            max_interval=max_interval,
            timeout=timeout,
            verbose=verbose,
        )

    @timed_cli
    def now(self, ref: str | None = None, *, project: str = ""):
        """查看当前分支的最新 CI/CD（短命令）。

        用法: cicd now [ref] [--project owner/repo]
        """
        return status_cicd(ref, project=project)

    @timed_cli
    def id(
        self,
        target: str,
        *,
        project: str = "",
        min_interval: float = 5.0,
        max_interval: float = 30.0,
        timeout: float | None = None,
        once: bool = False,
        verbose: bool = False,
    ):
        """监听某个 CI/CD ID（短命令）。

        用法: cicd id <run-id-or-pipeline-id>
        """
        return watch_cicd(
            None,
            target=target,
            project=project,
            config=PollConfig(
                min_interval=min_interval,
                max_interval=max_interval,
                timeout=timeout,
                once=once,
                verbose=verbose,
            ),
        )

    @timed_cli
    def log(self, target: str, *, project: str = "", job: str = ""):
        """看日志（默认不过滤失败）。

        用法: cicd log <run-id-or-job-id>
        """
        return logs_cicd(target, project=project, failed=False, job=job)

    @timed_cli
    def fail(self, target: str, *, project: str = "", job: str = ""):
        """看失败日志（短命令）。

        用法: cicd fail <run-id> [--job job-id]
        """
        return logs_cicd(target, project=project, failed=True, job=job)

    @timed_cli
    def play(self, job_id: str, *, project: str = ""):
        """启用 manual job（只点掉已有流水线里的手动任务，不新建流水线）。

        用法: cicd play <job-id> [--project group/repo]
        """
        return play_cicd(job_id, project=project)

    @timed_cli
    def status(self, ref: str | None = None, *, project: str = ""):
        """查看某个分支的最新 CI/CD

        用法: cicd status [ref] [--project owner/repo]
        """
        return status_cicd(ref, project=project)

    @timed_cli
    def watch(
        self,
        ref: str | None = None,
        *,
        target: str = "",
        project: str = "",
        min_interval: float = 5.0,
        max_interval: float = 30.0,
        timeout: float | None = None,
        once: bool = False,
        verbose: bool = False,
    ):
        """监听分支或某个 CI/CD，完成后输出最终结果

        用法:
          cicd watch [ref] [--project owner/repo]
          cicd watch --target <run-id-or-pipeline-id> [--project owner/repo]
        """
        return watch_cicd(
            ref,
            target=target,
            project=project,
            config=PollConfig(
                min_interval=min_interval,
                max_interval=max_interval,
                timeout=timeout,
                once=once,
                verbose=verbose,
            ),
        )

    @timed_cli
    def logs(self, target: str, *, project: str = "", failed: bool = False, job: str = ""):
        """查看某个 CI/CD 的日志/错误输出

        用法:
          cicd logs <run-id> [--failed] [--job job-id] [--project owner/repo]
          cicd logs <job-id> [--project group/repo]
        """
        return logs_cicd(target, project=project, failed=failed, job=job)


if __name__ == "__main__":
    if len(sys.argv) <= 1:
        sys.argv.append("--skills")
    run_cli(CicdCli())
