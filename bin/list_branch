#!/usr/bin/env python3
"""list_branch — 列出所有仓库的本地分支（fire 重构）"""
from __future__ import annotations

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
from lib.fire_base import BaseCli, run_cli, timed_cli
from lib.git import list_branch


class ListBranchCli(BaseCli):
    """列出所有仓库的本地分支"""

    @timed_cli
    def all(self):
        """扫描当前目录所有 Git 仓库并列分支"""
        return list_branch()


if __name__ == "__main__":
    run_cli(ListBranchCli())
