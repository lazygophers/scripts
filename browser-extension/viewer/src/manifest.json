{
  "manifest_version": 3,
  "name": "viewer",
  "version": "0.0.1",
  "description": "把本地的纯文本文件就地渲染成好看的样子：markdown 排版、代码上色、结构化数据折叠。",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "settings.html",
  "permissions": ["storage", "declarativeNetRequest", "nativeMessaging"],
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "viewer@lazygophers.com",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.css",
        "palette.css",
        "highlight.js",
        "markdown.js",
        "mermaid.js",
        "katex.js",
        "data.js",
        "csv.js",
        "log.js",
        "listing.js",
        "search.js",
        "viewer.html",
        "katex.css",
        "*.woff2",
        "*.woff",
        "*.ttf"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": ["file:///*"]
}
