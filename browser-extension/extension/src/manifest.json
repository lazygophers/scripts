{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.0.1",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "browse@lazygophers.com",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "panel.html",
    "default_icon": "assets/icon.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "omnibox": {
    "keyword": "br"
  },
  "commands": {
    "lg:snapshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "__MSG_cmdSnapshot__"
    }
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "cookies",
    "scripting",
    "webRequest",
    "webNavigation",
    "history",
    "bookmarks",
    "downloads",
    "downloads.open",
    "alarms",
    "pageCapture",
    "tabCapture",
    "desktopCapture",
    "clipboardRead",
    "clipboardWrite",
    "offscreen",
    "readingList",
    "topSites",
    "search",
    "webAuthenticationProxy",
    "sidePanel",
    "processes",
    "system.cpu",
    "system.display",
    "system.memory",
    "system.storage",
    "printing",
    "printingMetrics",
    "printerProvider",
    "dns",
    "idle",
    "power",
    "notifications",
    "userScripts",
    "declarativeContent",
    "proxy",
    "gcm"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "minimum_chrome_version": "122"
}
