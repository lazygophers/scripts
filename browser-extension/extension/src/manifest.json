{
  "manifest_version": 3,
  "name": "lazygophers browse",
  "version": "0.1.0",
  "description": "Local browser control over native messaging. Driven by the `browse` CLI.",
  "key": "",
  "action": {
    "default_title": "browse",
    "default_popup": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "cookies",
    "scripting",
    "webRequest",
    "webNavigation",
    "history",
    "bookmarks",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "116"
}
